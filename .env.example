# Both servers MUST bind to loopback. Run preview on MCP_PORT=8100 first.
MCP_PORT=8100
ADMIN_LOCAL_PORT=8865
ADMIN_PUBLIC_PORT=8866
ADMIN_PUBLIC_HOST=mcpadmin.asterline.dev
ADMIN_PASSWORD=REPLACE_WITH_STRONG_RANDOM_32_CHAR_PASSWORD
CF_TEAM_DOMAIN=https://red-hill-37f0.cloudflareaccess.com
CF_ACCESS_AUD=
CF_ADMIN_AUD=
MCP_ALLOWED_EMAILS=
# Use a new data directory first; an explicit migration is safer than live DB sharing.
MCP_DATA_DIR=.state-node
# For migration, use the same explicit workspace as the Python installation.
MCP_WORKSPACE_ROOT=C:\Users\YourName\Desktop\Cloud\workspace
# v1.9.2: task_start no longer requires MCP_ALLOWED_PROGRAMS or MCP_EXEC_DIRS.
# Any host executable still requires explicit host-operation approval.
GOTIFY_LOCAL_URL=http://127.0.0.1:8780
GOTIFY_APP_TOKEN=
# Sandboxie Plus Start.exe (full Windows path). No sandbox operations unless configured.
SANDBOXIE_START=C:\Program Files\Sandboxie-Plus\Start.exe
SANDBOXIE_BOX=AsterlinePlugins
SANDBOX_POLICY_CONFIRMED=0
NODE_EXE=C:\Program Files\nodejs\node.exe
NPM_EXE=C:\Program Files\nodejs\npm.cmd
MAX_PLUGIN_SECONDS=30

# Library Bridge — separate from OpenAI API Files, no ChatGPT cookie/token.
# If multiple Access emails are allowed, use --owner <email> with CLI.
LIBRARY_OWNER_EMAIL=
# Only official download domains, plus explicitly reviewed exact hostname exceptions.
LIBRARY_FILE_HOSTS=*.oaiusercontent.com,*.openai.com,*.chatgpt.com
# rclone is installed separately, configure `rclone config` first.
LIBRARY_RCLONE_EXE=rclone
LIBRARY_RCLONE_REMOTE=gdrive:Asterline
LIBRARY_CLOUD_LOCAL_ROOT=C:\Users\YourName\Desktop\AsterlineLibrarySync
